# Copie para .env e troque todos os valores. O arquivo .env não vai para o Git.
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=troque-esta-senha

# Mínimo de 32 bytes. Sugestão: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-bytes

# Primeiro bibliotecário, criado somente se ainda não existir nenhum.
BOOTSTRAP_LIBRARIAN_NAME=Bibliotecário Inicial
BOOTSTRAP_LIBRARIAN_EMAIL=bibliotecario@example.com
BOOTSTRAP_LIBRARIAN_PASSWORD=troque-esta-senha-tambem

# Porta publicada pelo balanceador Nginx.
API_PORT=8080
